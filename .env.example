# =========================================================================
# MadHats AI Design Studio — environment variables
# Copy to .env and fill in. NEVER commit a real .env.
# =========================================================================

# --- Supabase ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=madhats-assets

# --- Frontend (Vite) — single source of truth (root .env, not frontend/.env) ---
# Read by docker-compose (Docker runs) and by vite.config.ts envDir:'..' (host
# runs). Only VITE_-prefixed vars are inlined into the browser bundle.
VITE_API_BASE_URL=https://api.localhost
VITE_STORE_KEY=mh_pk_madhats_local

# --- Claude (conversation LLM) ---
ANTHROPIC_API_KEY=
CLAUDE_HAIKU_MODEL=claude-haiku-4-5-20251001

# --- Image generation (model IDs ONLY in env — never hardcoded) ---
GEMINI_API_KEY=
IMAGE_PROVIDER_PREVIEW=stub            # stub | gemini_flash | gemini_pro
IMAGE_PROVIDER_FINAL=stub              # stub | gemini_flash | gemini_pro
# Must be image-OUTPUT models (verify availability for your key via ListModels):
GEMINI_PREVIEW_MODEL=gemini-2.5-flash-image
GEMINI_FINAL_MODEL=gemini-3-pro-image

# --- Email (Resend) ---
RESEND_API_KEY=
RESEND_FROM_ADDRESS=studio@madhats.com.au
SALES_NOTIFICATION_EMAIL=sales@madhats.com.au

# --- Security ---
ADMIN_SECRET=change-me-in-production
# Signs admin-user login sessions (JWT). Optional — defaults to ADMIN_SECRET.
ADMIN_JWT_SECRET=
RATE_LIMIT_RPM=10
SIGNED_URL_TTL=3600
# CORS allowed origins. "*" (default) reflects any origin — kept open for now.
# Set a comma-separated list to lock it down, e.g. https://madhats.com.au,http://localhost:5173
ALLOWED_ORIGINS=*
VERIFICATION_TOKEN_TTL_SECONDS=900
# Quote link TTL in seconds (how long the emailed "request a quote" link stays valid). Default 30 days.
QUOTE_TOKEN_TTL_SECONDS=2592000

# --- AI usage caps (initial defaults; overridable in the admin Settings view) ---
REGEN_EDITS_PER_SESSION=3
DESIGNS_PER_CUSTOMER_PER_DAY=2

# --- App ---
APP_ENV=development
SENTRY_DSN=
EMAIL_VERIFY_BASE_URL=https://api.localhost
STUDIO_BASE_URL=https://localhost
CHATBOT_PERSONA_NAME=Ricardo
# Step-by-step canvas orchestrator (v2). "true" routes canvas sessions through
# the new tool-by-tool flow; unset/false keeps the current orchestrator.
CANVAS_ORCHESTRATOR_V2=false

# --- TLS / reverse proxy -----------------------------------------------------
# DEV: Caddy terminates TLS in front of both web services (internal CA).
# PROD: the BOX'S OWN NGINX terminates TLS (it already owned :80/:443, so Caddy
#   could neither bind them nor run an ACME challenge). nginx proxies both
#   hostnames to Caddy on 127.0.0.1:8480; Caddy only routes by hostname.
#   See nginx/madhats.conf.example and CLAUDE.md section 13c.
#
# NO LONGER USED, in either stack. Kept only so an existing .env doesn't look
# broken. Certificates are certbot's now (`sudo certbot certificates`), and the
# `email` directive is gone from caddy/Caddyfile.prod — so unlike before, a
# blank value here is completely harmless.
ACME_EMAIL=

# The two hostnames Caddy routes on (prod stack only). REQUIRED — compose uses
# `${...:?}`, so an unset value stops the proxy booting rather than silently
# serving blank pages.
#
# CADDY MATCHES BY HOSTNAME. These must EXACTLY equal the `server_name` in the
# nginx vhost, and the host part of VITE_API_BASE_URL / EMAIL_VERIFY_BASE_URL /
# STUDIO_BASE_URL below. A mismatch makes nginx forward correctly while Caddy
# returns an empty HTTP 200 (verified — a blank page, NOT a 404) — which looks
# like "nginx isn't forwarding to docker" and sends you to the wrong layer. VITE_API_BASE_URL is compiled into the bundle, so changing these
# means REBUILDING the frontend (`up -d --build frontend`), not just recreating.
#
#   staging: mhstaging.getaiconsult.com.au / api.mhstaging.getaiconsult.com.au
#   prod:    madhats.getaiconsult.com.au   / api.madhats.getaiconsult.com.au
STUDIO_HOST=
API_HOST=

# Hosts whose X-Forwarded-* headers the backend trusts, for client-IP recovery.
# Rate limiting keys on the client IP, so if this is wrong every customer shares
# one bucket -- and if it is too permissive, anyone who can reach the port
# directly can rotate the header for a fresh bucket per request.
#
# LEAVE THIS BLANK. Both compose files set it themselves, next to the port
# mapping that justifies it. Only set it here if you run the backend outside
# compose behind your own proxy, and then name that proxy's IP rather than "*".
TRUSTED_PROXY_HOSTS=

# Hostname the dev Caddy serves, so Vite points HMR at wss://<host>:443.
# Leave blank to use the plain-HTTP dev server on http://localhost:5173.
TLS_PROXY_HOST=localhost

# Production values for reference (set these in the SERVER's .env):
#   VITE_API_BASE_URL=https://api.madhats.getaiconsult.com.au
#   EMAIL_VERIFY_BASE_URL=https://api.madhats.getaiconsult.com.au
#   STUDIO_BASE_URL=https://madhats.getaiconsult.com.au
#   TLS_PROXY_HOST=                     # unused in prod (static build, no HMR)
